SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Service-role key (Supabase dashboard -> Settings -> API -> service_role).
# Server-only. Needed for admin operations (seeding, promoting a user to admin).
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API key (Google AI Studio -> aistudio.google.com/apikey)
GEMINI_API_KEY=

# Email (Resend) — optional locally; notify.server.ts logs to console instead of
# sending when these are blank.
RESEND_API_KEY=
EMAIL_FROM=

# Google sign-in via Clerk (clerk.com -> your app -> API Keys). Optional: without
# these, the "Continue with Google" button no-ops (hidden).
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Instagram Business Login (Meta for Developers -> your app -> Settings -> Basic).
# Optional: without these, the Instagram connect/analyze feature no-ops gracefully.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_manage_insights
# Bingo-internal secrets (generate your own, e.g. `openssl rand -hex 32`) — not from Meta.
SOCIAL_TOKEN_KEY=
INSTAGRAM_STATE_SECRET=
